# Anthropic API key for AI email summarization
ANTHROPIC_API_KEY=your-anthropic-api-key

# Same Supabase PostgreSQL connection string as the Rust backend
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# Same JWT secret as Rust backend — existing tokens remain valid across cutover
JWT_SECRET=your-existing-jwt-secret

# The first account created through the sign-in page is the only account that
# can change this workspace. You may use info@zaktrack.pm as the account email;
# it does not need to receive mail for password sign-in.

# Supabase Storage (for file uploads, replacing local ./uploads/ dir)
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
